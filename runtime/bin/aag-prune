#!/bin/sh
set -u
days="${1:-30}"
case "$days" in
  *[!0-9]*|"") echo "aag-prune: invalid days" >&2; exit 64 ;;
esac
home="${HOME:-/home/agent}"
prune() {
  [ -d "$1" ] || return 0
  find "$1" -type f -mtime +"$days" -delete 2>/dev/null
  find "$1" -mindepth 1 -type d -empty -delete 2>/dev/null
}
prune "$home/.claude/projects"
prune "$home/.claude/todos"
prune "$home/.claude/shell-snapshots"
prune "$home/.codex/sessions"
prune "$home/.codex/log"
prune "$home/.gemini/antigravity-cli/conversations"
prune "$home/.gemini/antigravity-cli/log"
prune "$home/.gemini/antigravity-cli/crashes"
prune "$home/.cache"
prune "$home/.npm/_logs"
for f in "$home/.codex/history.jsonl" "$home/.gemini/antigravity-cli/history.jsonl" "$home/.gemini/antigravity-cli/cli.log"; do
  if [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 5242880 ]; then
    tail -c 1048576 "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  fi
done
exit 0
