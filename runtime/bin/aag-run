#!/bin/sh
set -u
id="$1"
dir="$2"
shift 2
case "$id" in
  *[!A-Za-z0-9_]*|"") echo "aag-run: invalid id" >&2; exit 64 ;;
esac
mkdir -p /tmp/aag "$dir" || exit 65
cd "$dir" || exit 65
"$@" 0<&0 &
child=$!
echo "$child" > "/tmp/aag/$id.pid"
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
code=$?
rm -f "/tmp/aag/$id.pid"
exit "$code"
