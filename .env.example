# Application
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Authentication
# Global API key (Evolution API model). Generate with: openssl rand -hex 32
API_KEY=change_me

# Credential encryption (32 bytes, hex or base64). Generate with: openssl rand -hex 32
# Losing this key makes stored GitHub tokens and provider API keys unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# GitHub integration (GitHub App user tokens or OAuth App). Leave all empty to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Redirect page of the integrating backend that receives ?code&state and forwards them to POST /api/instances/{id}/github/callback
GITHUB_REDIRECT_URL=
# OAuth App scopes. GitHub Apps ignore this and use the app permissions.
GITHUB_SCOPES=repo

# Idle management
IDLE_TIMEOUT_SECONDS=300
IDLE_CHECK_INTERVAL_SECONDS=15

# Instance lifecycle
AUTO_START=false
MAX_ACTIVE_INSTANCES=10
MAX_AGENTS_PER_INSTANCE=3
RUN_TIMEOUT_SECONDS=3600

# Container resources
CONTAINER_MEMORY=4g
CONTAINER_CPUS=2
CONTAINER_PIDS=512
# Optional OCI runtime for stronger isolation, for example runsc (gVisor)
CONTAINER_RUNTIME=
CONTAINER_NETWORK=aag-instances
RUNTIME_IMAGE=arara-agent-runtime:local

# Docker
DOCKER_SOCKET=/var/run/docker.sock
# Docker Compose only: group that owns the Docker socket on the host (stat -c %g /var/run/docker.sock)
DOCKER_GID=0
GATEWAY_PORT=3000

# Retention of CLI session files inside each volume (days)
SESSION_RETENTION_DAYS=30
